FROM node:22-slim

WORKDIR /app

# Copy package files first (build cache layer)
COPY package.json ./

# Install dependencies
RUN npm install --no-audit --no-fund

# Copy source code
COPY . .

# Build Next.js (skipped at build time if source incomplete - dev mode fallback)
EXPOSE 3000

# Start Next.js in dev mode (port 3000 inside container)
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0", "--port", "3000"]