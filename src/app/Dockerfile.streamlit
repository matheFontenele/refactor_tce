FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install - --no-install-recommends - gcc && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir - -break-system-packages streamlit duckdb sqlglot reportlab openpyxl pandas polars great-expectations

# Copy application code
COPY . .

EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--host", "0.0.0.0", "--port", "8501"]