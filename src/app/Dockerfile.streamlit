FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (gcc needed for some Python packages)
RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages streamlit duckdb sqlglot reportlab openpyxl pandas polars

# Copy application code
COPY app.py .

EXPOSE 8501
CMD ["streamlit", "run", "app.py", "--host", "0.0.0.0", "--port", "8501"]