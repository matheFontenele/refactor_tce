FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application code
COPY main.py tce_client.py ai.py ai_db.py /app/

# NOTE: DuckDB database is mounted as read-only volume at /data/tce_analysis.duckdb
# The data volume is created and populated outside this container

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]